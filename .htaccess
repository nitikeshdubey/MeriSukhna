DirectoryIndex index.html
Options -Indexes -MultiViews
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(?:backend|tools|docs|work)(?:/|$) - [F,L,NC]
RewriteRule \.(?:sql|env|bak|log|zip)$ - [F,L,NC]
RewriteCond %{ENV:REDIRECT_STATUS} =404
RewriteRule ^404\.html$ - [L]

RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[?\s] [NC]
RewriteRule ^index(?:\.html)?$ https://merisukhna.com/ [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+blog/index(?:\.html)?[?\s] [NC]
RewriteRule ^blog/index(?:\.html)?$ https://merisukhna.com/blog/ [R=301,L,NE]
RewriteRule ^blog\.html$ https://merisukhna.com/blog/ [R=301,L,NE]
RewriteRule ^blog-(.+)\.html$ https://merisukhna.com/blog/$1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+gurdwaras(?:\.html)?[?\s] [NC]
RewriteRule ^gurdwaras(?:\.html)?$ https://merisukhna.com/gurudwaras [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+[A-Za-z0-9/_-]+\.html[?\s] [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !/404\.html$
RewriteRule ^(.+)\.html$ https://merisukhna.com/$1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://merisukhna.com/$1 [R=301,L,NE]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^merisukhna\.com$ [NC]
RewriteRule ^ https://merisukhna.com%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^gurudwaras$ gurdwaras.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
Header always set Strict-Transport-Security "max-age=15552000"
<FilesMatch "^(account|admin|404)\.html$">
Header always set X-Robots-Tag "noindex, nofollow"
</FilesMatch>
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 7 days"
ExpiresByType image/png "access plus 7 days"
ExpiresByType text/css "access plus 1 hour"
ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
